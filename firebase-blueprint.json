{
  "entities": {
    "User": {
      "title": "User",
      "description": "Organizational user account, staff credential, audit officer, or welfare member profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "CO_ADMIN", "MEMBER"] },
        "isFounder": { "type": "boolean" },
        "isAuditOfficer": { "type": "boolean" },
        "isMutedInChat": { "type": "boolean" },
        "founderBubbleColor": { "type": "string", "maxLength": 40 },
        "country": { "type": "string", "maxLength": 80 },
        "stateProvince": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "tehsil": { "type": "string", "maxLength": 100 },
        "cityTown": { "type": "string", "maxLength": 100 },
        "unionCouncil": { "type": "string", "maxLength": 120 },
        "assignedDistrict": { "type": "string", "maxLength": 100 },
        "assignedStateProvince": { "type": "string", "maxLength": 100 },
        "assignedOfficeTitle": { "type": "string", "maxLength": 120 },
        "membershipId": { "type": "string", "maxLength": 50 },
        "memberId": { "type": "string", "maxLength": 50 },
        "membershipStatus": { "type": "string", "enum": ["ACTIVE", "PENDING", "REJECTED", "EXPIRED", "SUSPENDED", "PENDING_DISTRICT_REVIEW", "RECOMMENDED_BY_DISTRICT", "PENDING_REGIONAL_REVIEW", "RECOMMENDED_BY_REGION"] },
        "avatarUrl": { "type": "string", "maxLength": 650000 },
        "photoUrl": { "type": "string", "maxLength": 650000 },
        "avatar": { "type": "string", "maxLength": 650000 },
        "cnic": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 300 },
        "joinDate": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "lastLoginAt": { "type": "string", "maxLength": 50 },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "maxLength": 60 },
        "province": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 40 },
        "profileCompleted": { "type": "boolean" },
        "isStaff": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name", "email", "role", "membershipStatus", "isStaff"]
    },
    "MembershipApplication": {
      "title": "MembershipApplication",
      "description": "Applicant onboarding requests evaluated via 2-stage verification workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "applicantName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "cnic": { "type": "string", "maxLength": 30 },
        "country": { "type": "string", "maxLength": 80 },
        "stateProvince": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "submittedAt": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["PENDING_DISTRICT_REVIEW", "RECOMMENDED_BY_DISTRICT", "PENDING_REGIONAL_REVIEW", "RECOMMENDED_BY_REGION", "ACTIVE", "REJECTED"] },
        "isOldMemberVerification": { "type": "boolean" },
        "oldMembershipNo": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "applicantName", "email", "phone", "cnic", "address", "submittedAt", "status", "isOldMemberVerification"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Contribution receipts and audit ledger records verified by Finance Officers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "receiptNumber": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "amount": { "type": "number" },
        "fundCategory": { "type": "string", "maxLength": 100 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "referenceNumber": { "type": "string", "maxLength": 80 },
        "date": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["PENDING_VERIFICATION", "VERIFIED", "REJECTED"] }
      },
      "required": ["id", "receiptNumber", "userId", "userName", "amount", "fundCategory", "paymentMethod", "referenceNumber", "date", "status"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Grievance desk tickets routed to district administrators and central leadership",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ticketNumber": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["OPEN", "UNDER_REVIEW", "IN_PROGRESS", "RESOLVED", "DISMISSED", "REJECTED"] },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] }
      },
      "required": ["id", "ticketNumber", "userId", "userName", "subject", "description", "status", "priority"]
    },
    "OfficeBearer": {
      "title": "OfficeBearer",
      "description": "Proposed organizational leadership seats appointed by Super Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 120 },
        "seatLabel": { "type": "string", "maxLength": 120 },
        "seatIndex": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "VACANT", "EXPIRED"] },
        "assignedUserId": { "type": "string", "maxLength": 128 },
        "assignedUserName": { "type": "string", "maxLength": 120 },
        "appointedDate": { "type": "string", "maxLength": 40 },
        "jurisdiction": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title", "status"]
    },
    "AppUpdate": {
      "title": "AppUpdate",
      "description": "Mobile application releases, APK links, and version change logs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "version": { "type": "string", "maxLength": 30 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "releaseDate": { "type": "string", "maxLength": 40 },
        "apkDownloadUrl": { "type": "string", "maxLength": 500 },
        "isPublished": { "type": "boolean" },
        "isMandatory": { "type": "boolean" }
      },
      "required": ["id", "version", "title", "description", "releaseDate", "isPublished", "isMandatory"]
    },
    "ChatConversation": {
      "title": "ChatConversation",
      "description": "One-to-one private conversation threads between community members and officers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "participantIds": { "type": "array" },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "lastMessageTime": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "participantIds"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Direct messages with photo/document attachments and timestamps",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "chatId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "participants": { "type": "array" },
        "text": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "senderId", "recipientId", "text", "timestamp"]
    },
    "CommunityChatMessage": {
      "title": "CommunityChatMessage",
      "description": "Ultra-Luxury Live Community Chat Room messages supporting voice notes, Islamic GIFs, reactions, pins, and Founder highlights",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "chatId": { "type": "string", "maxLength": 128 },
        "roomType": { "type": "string", "enum": ["COMMUNITY"] },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 120 },
        "senderRole": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "CO_ADMIN", "MEMBER"] },
        "senderIsFounder": { "type": "boolean" },
        "senderIsAuditOfficer": { "type": "boolean" },
        "senderBubbleColor": { "type": "string", "maxLength": 40 },
        "text": { "type": "string", "maxLength": 4000 },
        "timestamp": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "islamicGifId": { "type": "string", "maxLength": 64 },
        "isHighlighted": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "chatId", "senderId", "senderName", "senderRole", "text", "timestamp"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Real-time cross-device alerts including Super Admin sign-up/login bells, approvals, and payments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 60 },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 40 },
        "read": { "type": "boolean" },
        "targetRole": { "type": "string", "maxLength": 40 },
        "targetUserId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "type", "title", "message", "timestamp", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles, roles, audit officer designations, and administrative credentials"
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/MembershipApplication" },
      "description": "Membership registration pipeline"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Financial ledger of contributions and verified receipts"
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/Complaint" },
      "description": "Grievance desk tickets and resolution records"
    },
    "/office_bearers/{seatId}": {
      "schema": { "$ref": "#/entities/OfficeBearer" },
      "description": "Organizational leadership seats and appointments"
    },
    "/app_updates/{updateId}": {
      "schema": { "$ref": "#/entities/AppUpdate" },
      "description": "Mobile app updates and direct APK releases"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatConversation" },
      "description": "Private 1-to-1 chat threads"
    },
    "/direct_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Private 1-on-1 direct messages synced across devices"
    },
    "/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Direct chat messages and attachments (legacy alias)"
    },
    "/community_messages/{messageId}": {
      "schema": { "$ref": "#/entities/CommunityChatMessage" },
      "description": "Live Community Room messages synced across devices"
    },
    "/community_chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/CommunityChatMessage" },
      "description": "Live Community Room messages (legacy alias)"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "Real-time user and Super Admin alerts"
    }
  }
}
