rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Active Firebase Auth session (supports Google Auth AND OTP/Password bridged sessions)
    function isSignedIn() {
      return request.auth != null;
    }

    function isGoogleVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Founder Gate: Strictly bound to authorized root email
    function isFounder() {
      return isGoogleVerified() && request.auth.token.email == 'asadullah6959@gmail.com';
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Super Admin Gate: Founder OR appointed Additional Super Admin (when not suspended)
    function isSuperAdmin() {
      return isFounder() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc(request.auth.uid).role == 'SUPER_ADMIN' &&
        !(getUserDoc(request.auth.uid).isSuspended == true)
      );
    }

    function targetIsFounderDoc() {
      return existing().email == 'asadullah6959@gmail.com' || existing().isFounder == true;
    }

    // --- VALIDATION HELPERS ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'membershipStatus', 'isStaff']) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        data.role in ['SUPER_ADMIN', 'ADMIN', 'CO_ADMIN', 'MEMBER'] &&
        data.membershipStatus in ['ACTIVE', 'PENDING', 'REJECTED', 'EXPIRED', 'SUSPENDED', 'PENDING_DISTRICT_REVIEW', 'RECOMMENDED_BY_DISTRICT', 'PENDING_REGIONAL_REVIEW', 'RECOMMENDED_BY_REGION'] &&
        data.isStaff is bool &&
        (!('isAuditOfficer' in data) || data.isAuditOfficer is bool) &&
        (!('isMutedInChat' in data) || data.isMutedInChat is bool) &&
        (!('profileCompleted' in data) || data.profileCompleted is bool) &&
        (!('status' in data) || data.status is string) &&
        (!('lastLoginAt' in data) || data.lastLoginAt is string);
    }

    function isValidCommunityMessage(data) {
      return data.keys().hasAll(['id', 'chatId', 'senderId', 'senderName', 'senderRole', 'text', 'timestamp']) &&
        data.id is string && isValidId(data.id) &&
        data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
        data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 120 &&
        data.senderRole in ['SUPER_ADMIN', 'ADMIN', 'CO_ADMIN', 'MEMBER'] &&
        data.text is string && data.text.size() <= 4000 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 50;
    }

    // --- COLLECTION RULES ---

    // 1. Users Collection (Full Directory Sync + Founder Lock + Audit Officer protection)
    match /users/{userId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isFounder() ||
        (incoming().email != 'asadullah6959@gmail.com' && incoming().isFounder != true && incoming().role != 'SUPER_ADMIN' && (!('isAuditOfficer' in incoming()) || incoming().isAuditOfficer == false)) ||
        (userId == 'usr_super_admin' && incoming().email == 'asadullah6959@gmail.com' && incoming().role == 'SUPER_ADMIN' && incoming().isFounder == true)
      );

      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isFounder() ||
        (
          !targetIsFounderDoc() &&
          incoming().isFounder == existing().isFounder &&
          // Only Founder session can alter Founder doc; non-Founder updates preserve immutable Founder invariant
          (incoming().email == existing().email)
        ) ||
        (
          // Allow Founder profile metadata sync (e.g. avatar/hasPassword) without allowing role demotion or suspension
          targetIsFounderDoc() &&
          incoming().email == 'asadullah6959@gmail.com' &&
          incoming().role == 'SUPER_ADMIN' &&
          incoming().isFounder == true &&
          !(incoming().isSuspended == true)
        )
      );

      allow delete: if isSignedIn() && !targetIsFounderDoc() && (isFounder() || isSuperAdmin());
    }

    // 2. Membership Applications
    match /applications/{applicationId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(applicationId) &&
        incoming().keys().hasAll(['id', 'applicantName', 'email', 'status']) &&
        incoming().applicantName is string && incoming().applicantName.size() <= 120;
      allow delete: if isFounder() || isSuperAdmin();
    }

    // 3. Payments Ledger
    match /payments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(paymentId) &&
        incoming().keys().hasAll(['id', 'receiptNumber', 'userId', 'amount', 'status']) &&
        incoming().amount is number && incoming().amount >= 0;
      allow delete: if isFounder() || isSuperAdmin();
    }

    // 4. Grievance & Complaints
    match /complaints/{complaintId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(complaintId) &&
        incoming().keys().hasAll(['id', 'ticketNumber', 'userId', 'subject', 'status']) &&
        incoming().subject is string && incoming().subject.size() <= 160;
      allow delete: if isFounder() || isSuperAdmin();
    }

    // 5. Office-Bearers Seats (Constitutional Module)
    match /office_bearers/{seatId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(seatId);
    }

    match /office_bearer_history/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(historyId);
      allow update, delete: if false; // Immutable historical succession log
    }

    // 6. Mobile App Updates & Master Settings
    match /app_updates/{updateId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(updateId);
    }

    match /app_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(settingId);
    }

    // 7. Dedicated 1-to-1 Chat Messaging System
    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(chatId) &&
        incoming().keys().hasAll(['id', 'participantIds']);
      allow delete: if isFounder() || isSuperAdmin();
    }

    match /chat_messages/{messageId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(messageId) &&
        incoming().keys().hasAll(['id', 'chatId', 'senderId', 'recipientId', 'text', 'timestamp']) &&
        incoming().text is string && incoming().text.size() <= 4000;
      allow delete: if isFounder() || isSuperAdmin();
    }

    // 8. Live Community Chat Room (Voice Notes, Islamic GIFs, Reactions, Pins, Founder Protection)
    match /community_chat_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && isValidCommunityMessage(incoming());
      allow update: if isSignedIn() && isValidId(messageId) && isValidCommunityMessage(incoming()) && (
        // Founder's messages can never be soft-deleted by non-Founder
        !(existing().senderIsFounder == true && incoming().isDeleted == true && !isFounder())
      );
      allow delete: if isSignedIn() && !(existing().senderIsFounder == true && !isFounder());
    }

    // 9. Dual Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(announcementId) &&
        incoming().keys().hasAll(['id', 'title', 'content', 'publishedBy']);
      allow delete: if isSignedIn();
    }

    // 10. Audit Trail (Strictly Immutable)
    match /audit_logs/{auditId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(auditId) &&
        incoming().keys().hasAll(['id', 'timestamp', 'actorId', 'action']);
      allow update, delete: if false;
    }

    // 11. Global Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(notificationId);
      allow delete: if isSignedIn();
    }
  }
}
