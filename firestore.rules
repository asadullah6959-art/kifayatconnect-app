rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Absolute Super Admin Gate: Strictly bound to authorized root email
    function isSuperAdmin() {
      return isVerified() && request.auth.token.email == 'asadullah6959@gmail.com';
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isStaff() {
      return isVerified() && (isSuperAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc(request.auth.uid).isStaff == true));
    }

    function isFinanceOfficer() {
      return isVerified() && (isSuperAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc(request.auth.uid).role == 'FINANCE_OFFICER'));
    }

    function isDistrictAdmin() {
      return isVerified() && (isSuperAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc(request.auth.uid).role == 'ADMIN'));
    }

    function isCoAdmin() {
      return isVerified() && (isSuperAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc(request.auth.uid).role == 'CO_ADMIN'));
    }

    // --- VALIDATION HELPERS ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'membershipStatus', 'isStaff']) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        data.role in ['SUPER_ADMIN', 'FINANCE_OFFICER', 'ADMIN', 'CO_ADMIN', 'MEMBER'] &&
        data.membershipStatus in ['ACTIVE', 'PENDING', 'REJECTED', 'EXPIRED', 'SUSPENDED', 'PENDING_DISTRICT_REVIEW', 'RECOMMENDED_BY_DISTRICT', 'PENDING_REGIONAL_REVIEW', 'RECOMMENDED_BY_REGION'] &&
        data.isStaff is bool;
    }

    // --- COLLECTION RULES ---

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isVerified();
      allow list: if isVerified();

      allow create: if isVerified() && isValidId(userId) && isValidUser(incoming()) && (
        isSuperAdmin() ||
        (request.auth.uid == userId && incoming().role == 'MEMBER' && incoming().isStaff == false)
      );

      allow update: if isVerified() && isValidId(userId) && isValidUser(incoming()) && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().isStaff == existing().isStaff
        )
      );

      allow delete: if isSuperAdmin();
    }

    // 2. Membership Applications
    match /applications/{applicationId} {
      allow get, list: if isVerified() && (
        isStaff() ||
        resource.data.email == request.auth.token.email
      );

      allow create: if isVerified() && isValidId(applicationId);

      allow update: if isVerified() && isValidId(applicationId) && (
        isSuperAdmin() ||
        isDistrictAdmin()
      );

      allow delete: if isSuperAdmin();
    }

    // 3. Payments Ledger
    match /payments/{paymentId} {
      allow get, list: if isVerified() && (
        isFinanceOfficer() ||
        isDistrictAdmin() ||
        resource.data.userId == request.auth.uid
      );

      allow create: if isVerified() && isValidId(paymentId) &&
        incoming().userId == request.auth.uid;

      allow update: if isVerified() && isValidId(paymentId) && (
        isSuperAdmin() ||
        isFinanceOfficer() ||
        isDistrictAdmin()
      );

      allow delete: if isSuperAdmin();
    }

    // 4. Grievance & Complaints
    match /complaints/{complaintId} {
      allow get, list: if isVerified() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        isDistrictAdmin() ||
        isCoAdmin()
      );

      allow create: if isVerified() && isValidId(complaintId) &&
        incoming().userId == request.auth.uid;

      allow update: if isVerified() && isValidId(complaintId) && (
        isSuperAdmin() ||
        isDistrictAdmin() ||
        isCoAdmin() ||
        (request.auth.uid == existing().userId && existing().status == 'OPEN')
      );

      allow delete: if isSuperAdmin();
    }

    // 5. Office-Bearers Seats (Constitutional Module)
    match /office_bearers/{seatId} {
      allow read: if isVerified();
      allow write: if isSuperAdmin();
    }

    match /office_bearer_history/{historyId} {
      allow read: if isVerified();
      allow create: if isSuperAdmin();
      allow update, delete: if false; // Immutable historical succession log
    }

    // 6. Mobile App Updates & Releases
    match /app_updates/{updateId} {
      allow read: if true; // Publicly readable for app update checking
      allow write: if isSuperAdmin();
    }

    match /app_settings/{settingId} {
      allow read: if isVerified();
      allow write: if isSuperAdmin();
    }

    // 7. Dedicated 1-to-1 Chat Messaging System
    match /chats/{chatId} {
      allow read: if isVerified() && (
        request.auth.uid in resource.data.participantIds ||
        isSuperAdmin()
      );

      allow create: if isVerified() &&
        request.auth.uid in incoming().participantIds;

      allow update: if isVerified() &&
        request.auth.uid in existing().participantIds;

      allow delete: if isSuperAdmin();
    }

    match /chat_messages/{messageId} {
      allow read: if isVerified() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );

      allow create: if isVerified() &&
        incoming().senderId == request.auth.uid;

      allow update: if isVerified() && (
        existing().recipientId == request.auth.uid ||
        existing().senderId == request.auth.uid
      );

      allow delete: if isSuperAdmin();
    }

    // 8. Announcements
    match /announcements/{announcementId} {
      allow read: if isVerified();
      allow create, update: if isVerified() && (isSuperAdmin() || isDistrictAdmin() || isCoAdmin());
      allow delete: if isSuperAdmin();
    }

    // 9. Audit Trail (Immutable)
    match /audit_logs/{auditId} {
      allow read: if isVerified() && (isSuperAdmin() || isStaff());
      allow create: if isVerified() && incoming().actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // 10. Global Notifications
    match /notifications/{notificationId} {
      allow read: if isVerified();
      allow create: if isVerified();
      allow update, delete: if isVerified() && (
        isSuperAdmin() ||
        resource.data.targetUserId == request.auth.uid
      );
    }

  }
}
