rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && !id.matches('.*\\.\\..*') && id.matches('^[a-zA-Z0-9_.@\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isGoogleVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Founder Gate: Strictly bound to authorized root email
    function isFounder() {
      return isGoogleVerified() && request.auth.token.email == 'asadullah6959@gmail.com';
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Super Admin Gate: Founder OR appointed Additional Super Admin (when not suspended)
    function isSuperAdmin() {
      return isFounder() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc(request.auth.uid).role == 'SUPER_ADMIN' &&
        !(getUserDoc(request.auth.uid).isSuspended == true)
      );
    }

    function targetIsFounderDoc() {
      return ('email' in existing() && existing().email == 'asadullah6959@gmail.com') ||
        ('isFounder' in existing() && existing().isFounder == true);
    }

    // --- VALIDATION HELPERS ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'membershipStatus', 'isStaff']) &&
        data.id is string && isValidUserDocId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        data.role in ['SUPER_ADMIN', 'ADMIN', 'CO_ADMIN', 'MEMBER'] &&
        data.membershipStatus in ['ACTIVE', 'PENDING', 'REJECTED', 'EXPIRED', 'SUSPENDED', 'PENDING_DISTRICT_REVIEW', 'RECOMMENDED_BY_DISTRICT', 'PENDING_REGIONAL_REVIEW', 'RECOMMENDED_BY_REGION'] &&
        data.isStaff is bool &&
        (!('isAuditOfficer' in data) || data.isAuditOfficer is bool) &&
        (!('isMutedInChat' in data) || data.isMutedInChat is bool) &&
        (!('profileCompleted' in data) || data.profileCompleted is bool) &&
        (!('isOnline' in data) || data.isOnline is bool) &&
        (!('hasPassword' in data) || data.hasPassword is bool) &&
        (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 160)) &&
        (!('otpVerifiedOnce' in data) || data.otpVerifiedOnce is bool) &&
        (!('status' in data) || data.status is string) &&
        (!('lastLoginAt' in data) || data.lastLoginAt is string);
    }

    function isValidCommunityMessage(data) {
      return data.keys().hasAll(['id', 'chatId', 'senderId', 'senderName', 'senderRole', 'text', 'timestamp']) &&
        data.id is string && isValidId(data.id) &&
        data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
        data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 120 &&
        data.senderRole in ['SUPER_ADMIN', 'ADMIN', 'CO_ADMIN', 'MEMBER'] &&
        data.text is string && data.text.size() <= 5500 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 50 &&
        (!('isDeleted' in data) || data.isDeleted is bool) &&
        (!('isDeletedForEveryone' in data) || data.isDeletedForEveryone is bool) &&
        (!('deletedBy' in data) || (data.deletedBy is string && data.deletedBy.size() <= 120));
    }

    function isValidDirectMessage(data) {
      return data.keys().hasAll(['id', 'chatId', 'senderId', 'recipientId', 'text', 'timestamp']) &&
        data.id is string && isValidId(data.id) &&
        data.chatId is string && data.chatId.size() > 0 && data.chatId.size() <= 200 &&
        data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
        data.recipientId is string && data.recipientId.size() > 0 && data.recipientId.size() <= 128 &&
        data.text is string && data.text.size() <= 5500 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 50;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'message', 'timestamp']) &&
        data.id is string && isValidId(data.id) &&
        data.type is string && data.type.size() > 0 && data.type.size() <= 80 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.message is string && data.message.size() <= 1000 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 50;
    }

    // --- COLLECTION RULES ---
    // Note: Supports both Google-verified Web sessions and EmailJS OTP / Password / Android APK sessions
    // with schema validation and strict Founder protection guarantees.

    // 1. Users Collection (Full Real-Time Directory + Online Status + Founder Zero-Deletion Lock)
    match /users/{userId} {
      allow get, list: if true;

      allow create: if isValidUserDocId(userId) && isValidUser(incoming()) && (
        isFounder() ||
        (incoming().email != 'asadullah6959@gmail.com' && (!('isFounder' in incoming()) || incoming().isFounder != true) && incoming().role == 'MEMBER' && (!('isAuditOfficer' in incoming()) || incoming().isAuditOfficer == false)) ||
        ((userId == 'usr_super_admin' || userId == 'asadullah6959@gmail.com') && incoming().email == 'asadullah6959@gmail.com' && incoming().role == 'SUPER_ADMIN' && incoming().isFounder == true)
      );

      allow update: if isValidUserDocId(userId) && isValidUser(incoming()) && (
        isFounder() ||
        (
          !targetIsFounderDoc() &&
          ((!('isFounder' in existing()) && (!('isFounder' in incoming()) || incoming().isFounder != true)) || ('isFounder' in existing() && incoming().isFounder == existing().isFounder)) &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          (!('isAuditOfficer' in existing()) || incoming().isAuditOfficer == existing().isAuditOfficer)
        ) ||
        (
          targetIsFounderDoc() &&
          incoming().email == 'asadullah6959@gmail.com' &&
          incoming().role == 'SUPER_ADMIN' &&
          incoming().isFounder == true &&
          !(incoming().isSuspended == true)
        )
      );

      // Strict Zero-Deletion Lock: ONLY the Main Super Admin (Founder) can permanently delete non-Founder user records.
      allow delete: if isSignedIn() && !targetIsFounderDoc() && isFounder();
    }

    // 2. Membership Applications
    match /applications/{applicationId} {
      allow get, list: if true;
      allow create, update: if isValidId(applicationId) &&
        incoming().keys().hasAll(['id', 'applicantName', 'email', 'status']) &&
        incoming().applicantName is string && incoming().applicantName.size() <= 120;
      allow delete: if isFounder() || isSuperAdmin();
    }

    // 3. Payments Ledger
    match /payments/{paymentId} {
      allow get, list: if true;
      allow create, update: if isValidId(paymentId) &&
        incoming().keys().hasAll(['id', 'receiptNumber', 'userId', 'amount', 'status']) &&
        incoming().amount is number && incoming().amount >= 0;
      allow delete: if isFounder() || isSuperAdmin();
    }

    // 4. Grievance & Complaints
    match /complaints/{complaintId} {
      allow get, list: if true;
      allow create, update: if isValidId(complaintId) &&
        incoming().keys().hasAll(['id', 'ticketNumber', 'userId', 'subject', 'status']) &&
        incoming().subject is string && incoming().subject.size() <= 160;
      allow delete: if isFounder() || isSuperAdmin();
    }

    // 5. Office-Bearers Seats (Constitutional Module)
    match /office_bearers/{seatId} {
      allow read: if true;
      allow write: if isValidId(seatId);
    }

    match /office_bearer_history/{historyId} {
      allow read: if true;
      allow create: if isValidId(historyId);
      allow update, delete: if false;
    }

    // 6. Mobile App Updates & Master Settings
    match /app_updates/{updateId} {
      allow read: if true;
      allow write: if isValidId(updateId);
    }

    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && incoming().appName is string;
    }

    // 7. Dedicated 1-to-1 Personal Messaging System (Primary + Legacy Collection)
    match /chats/{chatId} {
      allow read: if true;
      allow create, update: if isValidId(chatId) &&
        incoming().keys().hasAll(['id', 'participantIds']);
      allow delete: if isFounder() || isSuperAdmin();
    }

    match /direct_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidDirectMessage(incoming());
      allow update: if isValidId(messageId) && isValidDirectMessage(incoming()) && (
        !(('senderIsFounder' in existing() && existing().senderIsFounder == true) &&
          (('isDeleted' in incoming() && incoming().isDeleted == true) || ('isDeletedForEveryone' in incoming() && incoming().isDeletedForEveryone == true)) &&
          !isFounder())
      );
      allow delete: if (isFounder() || isSuperAdmin()) && !(('senderIsFounder' in existing() && existing().senderIsFounder == true) && !isFounder());
    }

    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidDirectMessage(incoming());
      allow update: if isValidId(messageId) && isValidDirectMessage(incoming()) && (
        !(('senderIsFounder' in existing() && existing().senderIsFounder == true) &&
          (('isDeleted' in incoming() && incoming().isDeleted == true) || ('isDeletedForEveryone' in incoming() && incoming().isDeletedForEveryone == true)) &&
          !isFounder())
      );
      allow delete: if (isFounder() || isSuperAdmin()) && !(('senderIsFounder' in existing() && existing().senderIsFounder == true) && !isFounder());
    }

    // 8. Live Community Chat Room (Primary + Legacy Collection, Global Soft-Delete & Hard-Delete Clear)
    match /community_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidCommunityMessage(incoming());
      allow update: if isValidId(messageId) && isValidCommunityMessage(incoming());
      allow delete: if isValidId(messageId);
    }

    match /community_chat_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidCommunityMessage(incoming());
      allow update: if isValidId(messageId) && isValidCommunityMessage(incoming());
      allow delete: if isValidId(messageId);
    }

    match /chat_typing/{typingId} {
      allow read: if true;
      allow create, update: if isValidId(typingId) &&
        incoming().keys().hasAll(['id', 'chatId', 'userId', 'userName', 'updatedAt']) &&
        incoming().id is string && isValidId(incoming().id) &&
        incoming().chatId is string && incoming().chatId.size() > 0 && incoming().chatId.size() <= 128 &&
        incoming().userId is string && incoming().userId.size() > 0 && incoming().userId.size() <= 128 &&
        incoming().userName is string && incoming().userName.size() > 0 && incoming().userName.size() <= 120 &&
        incoming().updatedAt is number;
      allow delete: if isValidId(typingId);
    }

    // 9. Dual Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isValidId(announcementId) &&
        incoming().keys().hasAll(['id', 'title', 'content', 'publishedBy']);
      allow delete: if true;
    }

    // 10. Audit Trail (Strictly Immutable)
    match /audit_logs/{auditId} {
      allow read: if true;
      allow create: if isValidId(auditId) &&
        incoming().keys().hasAll(['id', 'timestamp', 'actorId', 'action']);
      allow update, delete: if false;
    }

    // 11. Global Real-Time Notifications (Sign-Up/Login Alerts & Role Alerts)
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if isValidId(notificationId) && isValidNotification(incoming());
      allow delete: if true;
    }

    // 12. Atomic Monotonic Serial Number Counters (KC-YYYY-XXXX)
    function isValidCounter(data) {
      return data.keys().hasAll(['id', 'year', 'nextNumber']) &&
        data.keys().hasOnly(['id', 'year', 'nextNumber', 'lastSerial', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.year is number && data.year >= 2024 && data.year <= 2100 &&
        data.nextNumber is number && data.nextNumber >= 2 && data.nextNumber <= 9999999 &&
        (!('lastSerial' in data) || (data.lastSerial is string && data.lastSerial.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /counters/{counterId} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidId(counterId) && isValidCounter(incoming()) && incoming().nextNumber == 2;
      allow update: if isValidId(counterId) && isValidCounter(incoming()) &&
        incoming().id == existing().id &&
        incoming().year == existing().year &&
        incoming().nextNumber == existing().nextNumber + 1;
      allow delete: if false;
    }
  }
}
